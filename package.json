{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-plugin-litellm-einfra",
  "version": "1.6.0",
  "description": "OpenCode CLI (v1 and v2) plugin for LiteLLM proxy support with auto-detection and dynamic model discovery — e-infra distribution with non-standard token-limit support",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "index.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "opencode",
    "litellm",
    "lite-llm",
    "plugin",
    "llm-proxy",
    "openai-compatible"
  ],
  "author": "Yusef Mohamadi (https://github.com/yuseferi)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jeysef/opencode-litellm.git"
  },
  "bugs": {
    "url": "https://github.com/Jeysef/opencode-litellm/issues"
  },
  "homepage": "https://github.com/Jeysef/opencode-litellm#readme",
  "dependencies": {
    "@opencode-ai/plugin": "^1.14.0",
    "@opencode/plugin": "^2.0.14"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
